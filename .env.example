# Copy to .env.local for local development.

# PostgreSQL connection string. If unset, the app falls back to local
# JSON file storage under ./data (servers.json + users.json).
# DATABASE_URL="postgresql://infra_admin:password@localhost:5432/asset_manager?sslmode=disable"

# Secret used to sign session JWTs. REQUIRED for authentication to work.
# Generate a strong value, e.g.: openssl rand -base64 32
SESSION_SECRET="dev-only-change-me-32-byte-secret"

# Password for the auto-seeded "admin" account on first boot.
# Defaults to "admin" if not set.
ADMIN_DEFAULT_PASSWORD="admin"
